# Puerto del servidor web
PORT=3000

# Cadena de conexion a PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/lean_exam

# Pon "true" si tu proveedor de base de datos exige SSL (Render, Supabase, Heroku, etc.)
PGSSL=false

# Contrasena del panel de administrador
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar los tokens de sesion (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
